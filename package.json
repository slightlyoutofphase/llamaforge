{
  "name": "llamaforge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"bun run src/server/index.ts\" \"vite\"",
    "build": "vite build && bun build src/server/index.ts --target bun --outdir dist/server",
    "bunbuild": "bun run build.ts",
    "start": "bun run dist/server/index.js",
    "test": "bun test",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project tsconfig.server.json",
    "lint": "biome lint . --max-diagnostics 500 && eslint",
    "clean": "bun run scripts/clean.mjs",
    "docs": "typedoc"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@huggingface/gguf": "^0.4.2",
    "@huggingface/jinja": "^0.5.9",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.15",
    "@uiw/react-codemirror": "^4.25.10",
    "@vitejs/plugin-react": "~6.0.2",
    "bun-plugin-tailwind": "^0.1.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "highlight.js": "^11.11.1",
    "json2gbnf": "^0.1.4",
    "katex": "^0.17.0",
    "lucide-react": "~1.18.0",
    "mathjs": "^15.2.0",
    "mime": "^4.1.0",
    "motion": "^12.40.0",
    "pdfjs-dist": "^6.0.227",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-dropzone": "^15.0.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@happy-dom/global-registrator": "^20.10.3",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/mime": "^4.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "autoprefixer": "^10.5.0",
    "bun": "^1.3.14",
    "concurrently": "^10.0.3",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7",
    "happy-dom": "^20.10.3",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.1",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "~6.0.3",
    "vite": "~8.0.16"
  }
}
