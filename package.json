{
  "name": "llamaforge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "//": "typescript is the 6.x compiler/API used by tsc, eslint, and typedoc. Do not alias it to @typescript/typescript6: that remaps @typescript/old onto itself and breaks eslint. @typescript/native is the unused TS 7 native compiler (tsgo).",
  "scripts": {
    "dev": "concurrently \"bun run src/server/index.ts\" \"vite\"",
    "build": "vite build && bun build src/server/index.ts src/server/builtinTools/calculateWorker.ts --target bun --outdir dist/server",
    "bunbuild": "bun run build.ts",
    "start": "bun run dist/server/index.js",
    "test": "bun test",
    "test:e2e": "bun test ./tests/e2e",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project tsconfig.server.json",
    "typecheck:tests": "tsc --noEmit --project tsconfig.test.json",
    "lint": "npm run typecheck && npm run typecheck:tests && biome lint . --max-diagnostics 500 && eslint",
    "clean": "bun run scripts/clean.mjs",
    "docs": "typedoc"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@huggingface/gguf": "^0.4.6",
    "@huggingface/jinja": "^0.5.9",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.29",
    "@uiw/react-codemirror": "^4.25.11",
    "@vitejs/plugin-react": "~6.0.5",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "highlight.js": "^11.12.0",
    "json2gbnf": "^0.1.4",
    "katex": "^0.17.0",
    "lucide-react": "~1.18.0",
    "mathjs": "^15.2.0",
    "mime": "^4.1.0",
    "motion": "^12.43.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^15.0.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@happy-dom/global-registrator": "^20.11.2",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/mime": "^4.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@typescript/native": "npm:typescript@~7.0.2",
    "autoprefixer": "^10.5.4",
    "bun": "^1.4.0",
    "bun-plugin-tailwind": "0.1.2",
    "concurrently": "^10.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.11.2",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "~6.0.2",
    "vite": "~8.2.1"
  },
  "allowScripts": {
    "bun@1.3.14": true
  }
}
